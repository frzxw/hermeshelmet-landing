---
import { Image } from "astro:assets";
import helmet from "../assets/helmet.webp";

// The helmet, annotated: each part stands for one role in a run.
// x/y place the pin on the helmet (percent of the image), len is the leader line.
const parts = [
  { n: 1, role: "Workers", count: "×3", line: "Build from a brief, in parallel.", x: 21, y: 27, side: "l", len: 132 },
  {
    n: 2,
    role: "Orchestrator",
    count: "×1",
    line: "Plans the work, writes every brief.",
    x: 64,
    y: 34,
    side: "r",
    len: 196,
  },
  {
    n: 3,
    role: "Supervisor",
    count: "×1",
    line: "Reads the result. Never edits it.",
    x: 80,
    y: 77,
    side: "r",
    len: 132,
  },
];
---

<section id="architecture" class="sec">
  <div class="wrap">
    <h2 class="rv h2 big roles-title">
      One plans.
      <br />
      Three build.
      <br />
      One checks.
    </h2>

    <figure
      class="anat rv"
      aria-label="The Helmet: the wing is three workers, the crown is the orchestrator, the visor is the supervisor"
    >
      <div class="anat-helmet float">
        <Image src={helmet} alt="" widths={[420, 840]} sizes="(max-width: 760px) 64vw, 420px" loading="eager" />
        {parts.map((p) => (
          <div class={`pin pin-${p.side}`} style={`left:${p.x}%;top:${p.y}%;--len:${p.len}px`}>
            <span class="pin-dot">{p.n}</span>
            <span class="pin-line" aria-hidden="true" />
            <div class="pin-card">
              <b>
                {p.role} <span>{p.count}</span>
              </b>
              <p>{p.line}</p>
            </div>
          </div>
        ))}
      </div>
      <ol class="anat-list">
        {parts.map((p) => (
          <li>
            <span class="pin-dot">{p.n}</span>
            <div>
              <b>
                {p.role} <span>{p.count}</span>
              </b>
              <p>{p.line}</p>
            </div>
          </li>
        ))}
      </ol>
    </figure>
  </div>
</section>
