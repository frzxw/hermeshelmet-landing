---
const workers = ["Worker 1", "Worker 2", "Worker 3"];
---

<section id="architecture" class="sec dark-sec">
  <div class="dark rv">
    <div class="wrap arch">
      <div>
        <p class="kicker">Architecture</p>
        <h2 class="h2 big" style="margin-top:16px">
          Optimized agents,
          <br />
          not just more of them.
        </h2>
        <p class="lead" style="max-width:420px">
          The orchestrator plans and writes every prompt. Workers get only what they need. The supervisor checks the
          result without touching a file.
        </p>
      </div>

      <div
        class="orbit"
        role="img"
        aria-label="An orchestrator at the center, three workers circling it, and a read-only supervisor watching from outside"
      >
        <div class="ring ring-outer"></div>
        <div class="ring ring-inner"></div>
        <div class="glowball" aria-hidden="true"></div>
        <span class="node node-sup">Supervisor</span>
        <span class="node node-core">Orchestrator</span>
        <div class="spin" aria-hidden="true">
          {workers.map((w, i) => (
            <span class={`sat sat-${i}`}>
              <span class="unspin">{w}</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
