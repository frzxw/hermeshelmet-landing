---
// Three roles as a hand of cards, echoing the Hermes Agent badge.
const cards = [
  { n: "1", role: "Orchestrator", line: "Plans the work and writes every brief.", glyph: "star", tone: "sky" },
  { n: "3", role: "Workers", line: "Build from a brief, in parallel.", glyph: "blocks", tone: "mid" },
  { n: "1", role: "Supervisor", line: "Reads the result. Never edits it.", glyph: "eye", tone: "lav" },
];
---

<section id="architecture" class="sec roles">
  <div class="wrap">
    <h2 class="rv h2 big roles-title">
      One plans.
      <br />
      Three build.
      <br />
      One checks.
    </h2>

    <ol class="hand">
      {cards.map((c, i) => (
        <li class={`rcard rcard-${i}`}>
          <div class="card-corner">
            <b>{c.n}</b>
            <span>{c.role}</span>
          </div>
          <div class={`card-art tone-${c.tone}`} aria-hidden="true">
            {c.glyph === "star" && (
              <svg viewBox="0 0 100 100">
                <path d="M50 6 C53 36 64 47 94 50 C64 53 53 64 50 94 C47 64 36 53 6 50 C36 47 47 36 50 6 Z" />
              </svg>
            )}
            {c.glyph === "blocks" && (
              <svg viewBox="0 0 100 100">
                <rect x="14" y="58" width="72" height="22" rx="6" />
                <rect x="22" y="33" width="56" height="22" rx="6" opacity=".7" />
                <rect x="30" y="8" width="40" height="22" rx="6" opacity=".45" />
              </svg>
            )}
            {c.glyph === "eye" && (
              <svg viewBox="0 0 100 100">
                <path
                  d="M6 50 C22 24 36 16 50 16 C64 16 78 24 94 50 C78 76 64 84 50 84 C36 84 22 76 6 50 Z"
                  class="eye-lid"
                />
                <circle cx="50" cy="50" r="15" />
              </svg>
            )}
          </div>
          <p class="card-line">{c.line}</p>
          <div class="card-corner flip" aria-hidden="true">
            <b>{c.n}</b>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
