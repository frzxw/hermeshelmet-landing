---
const legend = [
  { label: "System prompt", size: "10k", n: 1 },
  { label: "Skills", size: "6k", n: 2 },
  { label: "Memory", size: "16k", n: 3 },
  { label: "Tools", size: "14k", n: 4 },
  { label: "Conversation", size: "38k", n: 5 },
];
const bars = [
  { n: 5, v: 0.42 },
  { n: 4, v: 0.23 },
  { n: 3, v: 0.16 },
  { n: 2, v: 0.08 },
  { n: 1, v: 0.05 },
];
const tactics = [
  { k: "~500", unit: "tokens", title: "Short skill cards", body: "Deep references load only when a step needs them." },
  {
    k: "1st",
    unit: "scripts",
    title: "Scripts before models",
    body: "Every check that can be a script is one, and costs nothing.",
  },
  {
    k: "0",
    unit: "mid-task switches",
    title: "Cache-first routing",
    body: "Models change only between cards, so prefixes stay warm.",
  },
];
---

<section class="band" aria-labelledby="tokens-h">
  <div class="wrap">
    <div class="sec-head">
      <p class="rv eyebrow kicker">Token budget</p>
      <h2 id="tokens-h" class="rv h2" style="margin-top:16px">
        Every token goes to work that counts.
      </h2>
      <p class="rv rv2 lead">Helmet treats tokens and cache as a budget, and shows you the receipt.</p>
    </div>

    <div class="tok-grid">
      <div class="card-w stat stat-hero glow rv">
        <div role="img" aria-label="About 83 percent" class="big-num">
          <span aria-hidden="true">
            ~<span class="cnt"></span>
            <span class="sun">%</span>
          </span>
        </div>
        <p class="stat-l">of input tokens served from cache in our own multi-agent runs.</p>
      </div>

      <div class="card-w glow rv rv2 meter">
        <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px">
          <h3 class="title" style="font-size:20px;line-height:26px">
            See your context
          </h3>
          <code class="eyebrow">/context</code>
        </div>
        <p class="body-m" style="max-width:420px">
          What fills the window, itemized, with the share served from cache.
        </p>
        <div class="meter-bar" aria-hidden="true">
          {bars.map((b) => (
            <div class="cv" style={`background:var(--bar-${b.n});transform:scaleX(${b.v})`} />
          ))}
        </div>
        <div class="meter-legend">
          {legend.map((l) => (
            <span>
              <i style={`background:var(--bar-${l.n})`} />
              {l.label}
              <b>{l.size}</b>
            </span>
          ))}
        </div>
        <p class="eyebrow" style="margin-top:16px">
          42% of 200k · 81% read from cache
        </p>
      </div>
    </div>

    <div class="grid3" style="margin-top:var(--gap)">
      {tactics.map((t, i) => (
        <div class:list={["card-w glow rv", i === 1 && "rv2", i === 2 && "rv3"]}>
          <p class="tac-k">
            {t.k} <span>{t.unit}</span>
          </p>
          <h3 class="title" style="margin-top:32px;font-size:20px;line-height:26px">
            {t.title}
          </h3>
          <p class="body-m">{t.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
