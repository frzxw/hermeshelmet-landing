---
// The squeeze: as you scroll, five full-history contexts shrink to five briefs.
// Token counts are one illustrative run, drawn on a 64k scale.
const SCALE = 64;
const rows = [
  { name: "Orchestrator", k: 38, tone: "o", note: "plan.md" },
  { name: "Worker 1", k: 9, tone: "w", note: "brief-1.md" },
  { name: "Worker 2", k: 11, tone: "w", note: "brief-2.md" },
  { name: "Worker 3", k: 6, tone: "w", note: "brief-3.md" },
  { name: "Supervisor", k: 14, tone: "s", note: "the diff" },
];
---

<section id="features" class="squeeze" aria-labelledby="sq-title">
  <div class="sq-stage">
    <div class="wrap sq-grid">
      <div class="sq-copy">
        <h2 id="sq-title" class="h2 big">
          Five agents.
          <br />A quarter of the context.
        </h2>
        <div class="sq-swap" aria-hidden="true">
          <p class="sq-a">Spawned, every agent rereads the whole history.</p>
          <p class="sq-b">With Helmet, each one reads only its brief.</p>
        </div>
        <p class="sr-only">
          Spawning five agents copies the full history into each, about 310k tokens. Helmet gives each agent a brief,
          about 78k tokens in total.
        </p>
        <p class="sq-count" aria-hidden="true">
          <span class="sq-num"></span>
          <small>k tokens</small>
        </p>
      </div>

      <ul class="sq-bars" aria-hidden="true">
        {rows.map((r) => (
          <li style={`--w:${(r.k / SCALE) * 100}%`}>
            <span class="sq-name">{r.name}</span>
            <span class="sq-track">
              <span class={`sq-fill t-${r.tone}`} />
              <span class="sq-note">
                <span class="n-a">full history</span>
                <span class="n-b">{r.note}</span>
              </span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
