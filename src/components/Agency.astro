---
type Step = { role: string; out: string } | { gate: string };
const steps: Step[] = [
  { role: "Product lead", out: "spec.md" },
  { gate: "You approve the spec" },
  { role: "Architect and designer", out: "architecture.md · DESIGN.md" },
  { gate: "You approve the design" },
  { role: "Planner", out: "plan.md · board cards" },
  { role: "Engineers, in parallel", out: "commits · tests" },
  { role: "Reviewer, different model family", out: "review verdict" },
  { role: "QA", out: "qa-report.md" },
  { gate: "You approve the release" },
  { role: "Release lead", out: "RELEASE.md · tagged release" },
];
let n = 0;
---

<section id="architecture" class="sec dark-sec">
  <div class="dark rv">
    <div class="wrap agency">
      <div class="agency-copy">
        <p class="eyebrow kicker">The agency</p>
        <h2 class="h2" style="margin-top:16px">
          A senior team, made of Hermes agents.
        </h2>
        <p class="lead">
          Each role is its own Hermes profile with a fresh context and only the skills it needs. Roles hand off through
          files in your repo, never through a shared chat, and you decide the expensive calls.
        </p>
        <ul class="facts">
          <li>Sized to the task, never the full team for a typo</li>
          <li>
            Every handoff is a readable file in <code>.helmet/</code>
          </li>
          <li>The reviewer runs on a different model family than the author</li>
        </ul>
      </div>

      <ol class="pipe" aria-label="Agency pipeline">
        {steps.map((s) =>
          "gate" in s ? (
            <li class="pipe-gate">
              <span class="gate-dot" aria-hidden="true" />
              {s.gate}
            </li>
          ) : (
            <li class="pipe-step">
              <span class="pipe-n" aria-hidden="true">
                {String(++n).padStart(2, "0")}
              </span>
              <span class="pipe-role">{s.role}</span>
              <code class="pipe-out">{s.out}</code>
            </li>
          ),
        )}
      </ol>
    </div>
  </div>
</section>
