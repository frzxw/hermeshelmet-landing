---
import { providers } from "../data/providers";

// Each half of the track must be wider than the viewport, or the -50% loop reveals a gap on the right.
const runs = [false, true, true, true, true, true, true, true];
---

<section aria-label="Subscriptions Helmet works with" class="rv" style="padding-top:80px;overflow:hidden">
  <p class="eyebrow" style="text-align:center;padding:0 var(--gutter)">
    Use the subscriptions you already pay for.
  </p>
  <div class="marquee-wrap" style="margin-top:28px;overflow:hidden">
    <div
      class="marquee marquee-slow"
      style="display:flex;align-items:center;width:max-content;gap:72px;padding-right:72px"
    >
      {runs.map((hidden) =>
        providers.map((p) => (
          <span
            class="lg"
            role={hidden ? undefined : "img"}
            aria-label={hidden ? undefined : p.name}
            aria-hidden={hidden ? "true" : undefined}
            style="display:block;flex:none"
            set:html={p.svg}
          />
        )),
      )}
    </div>
  </div>
  <p style="margin:24px 0 0;text-align:center;font-size:12px;line-height:16px;letter-spacing:0.2px;color:var(--faint);padding:0 var(--gutter)">
    Logos belong to their respective owners and are shown to indicate compatibility.
  </p>
  <div class="wrap" style="margin-top:80px">
    <hr style="margin:0;border:0;height:1px;background:var(--line)" />
  </div>
</section>
