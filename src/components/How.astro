---
import InstallStepper from "./InstallStepper.astro";
---

<section id="how" class="sec">
  <div class="wrap">
    <div class="sec-head center">
      <p class="rv kicker">How it works</p>
      <h2 class="rv h2 big" style="margin-top:16px">
        One command.
        <br />
        No setup maze.
      </h2>
      <p class="rv rv2 lead">No Hermes yet? It installs that too, then asks which models you have.</p>
    </div>
    <div class="frame frame-aurora install rv">
      <InstallStepper />
    </div>
  </div>
</section>
