---
import InstallStepper from "./InstallStepper.astro";

const chip =
  "display:inline-flex;align-items:center;height:30px;padding:0 14px;border-radius:var(--radius-pill);font-size:13px;font-weight:600";
const modelRows = [
  { name: "Your fastest model", status: "Connected", strong: false },
  { name: "Your strongest model", status: "Connected", strong: false },
  { name: "Your local model", status: "Auto-routed", strong: true },
];
---

<section id="how" class="sec">
  <div class="wrap" style="display:flex;flex-wrap:wrap;gap:48px;align-items:flex-start">
    <div class="rv stick" style="flex:1 1 300px;min-width:0;position:sticky;top:120px">
      <p class="eyebrow kicker">How it works</p>
      <h2 class="h2" style="margin-top:16px">
        No jargon, no slash commands, no setup maze.
      </h2>
      <p class="lead">Three steps from nothing to a Hermes that works like a team.</p>
    </div>

    <div style="flex:1.4 1 460px;min-width:0;display:flex;flex-direction:column">
      <!-- 1 -->
      <div class="rv step-row">
        <span class="idx" aria-hidden="true">
          01
        </span>
        <div style="flex:1;min-width:0">
          <h3 class="title" style="font-size:20px;line-height:26px">
            Install with one command.
          </h3>
          <p class="body-m" style="max-width:460px">
            No Hermes yet? Helmet sets that up too. Hermes itself, including its default UI, becomes the supercharged
            version.
          </p>
          <InstallStepper />
        </div>
      </div>

      <!-- 2 -->
      <div class="rv step-row">
        <span class="idx" aria-hidden="true">
          02
        </span>
        <div style="flex:1;min-width:0">
          <h3 class="title" style="font-size:20px;line-height:26px">
            Plug in your models.
          </h3>
          <p class="body-m" style="max-width:460px">
            Add whichever models you already have. Helmet routes between them for you. No tiers or categories to learn.
          </p>
          <div style="margin-top:24px;padding:4px 20px;border-radius:var(--radius-card);background:var(--surface)">
            {modelRows.map((r, i) => (
              <div
                style={`display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0;font-size:15px;${i ? "border-top:1px solid var(--line)" : ""}`}
              >
                <span style="font-weight:600">{r.name}</span>
                <span style={r.strong ? "font-weight:600" : "color:var(--muted)"}>{r.status}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- 3 -->
      <div class="rv step-row">
        <span class="idx" aria-hidden="true">
          03
        </span>
        <div style="flex:1;min-width:0">
          <h3 class="title" style="font-size:20px;line-height:26px">
            Describe the work.
          </h3>
          <p class="body-m" style="max-width:460px">
            Helmet reads the situation. No plan yet? It plans first. Then each piece goes to the right agent.
          </p>
          <div style="margin-top:24px">
            <div style="display:flex;align-items:center;padding:14px 18px;border-radius:var(--radius-card);background:var(--surface);font-size:15px">
              Add rate limiting to the API.
              <span
                class="caret"
                aria-hidden="true"
                style="display:inline-block;width:2px;height:18px;margin-left:2px;background:var(--ink)"
              ></span>
            </div>
            <div style="margin-top:12px;display:flex;flex-wrap:wrap;gap:8px">
              <span style={`${chip};background:var(--ink);color:var(--white)`}>Plan first</span>
              <span style={`${chip};background:var(--fill)`}>3 workers</span>
              <span style={`${chip};background:var(--fill)`}>Verify</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
