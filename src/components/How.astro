---
import InstallStepper from "./InstallStepper.astro";

const steps = [
  {
    title: "Run the installer.",
    body: "No Hermes yet? It sets that up first, then adds Helmet on top. Every config change is shown as a diff before it’s applied.",
  },
  {
    title: "Tell it what you have.",
    body: "A frontier subscription, a few API keys, or only free and local models. Helmet tests each one and routes work between them.",
  },
  {
    title: "Describe the work.",
    body: "Talk to Hermes as usual. No trigger words, categories or model names to learn. Say “skip” whenever you want less process.",
  },
];
---

<section id="how" class="sec">
  <div class="wrap">
    <div class="sec-head">
      <p class="rv eyebrow kicker">Get started</p>
      <h2 class="rv h2" style="margin-top:16px">
        From zero to a working team in one command.
      </h2>
    </div>
    <div class="how">
      <ol class="how-steps">
        {steps.map((s, i) => (
          <li class:list={["rv", i === 1 && "rv2", i === 2 && "rv3"]}>
            <span class="how-n" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <h3 class="title" style="font-size:20px;line-height:26px">
                {s.title}
              </h3>
              <p class="body-m">{s.body}</p>
            </div>
          </li>
        ))}
        <li class="rv rv3 how-note">
          Helmet never asks for or stores your API keys. Sign-in goes through Hermes itself.
        </li>
      </ol>
      <div class="frame rv rv2 how-term">
        <InstallStepper />
      </div>
    </div>
  </div>
</section>
