---
import { Image } from "astro:assets";
import helmet from "../assets/helmet.webp";
import { navLinks } from "../data/site";
import RollButton from "./RollButton.astro";
---

<header id="top" style="position:sticky;top:16px;z-index:20;padding:16px 16px 0;box-sizing:border-box">
  <div
    class="in-up"
    style="position:relative;overflow:hidden;max-width:760px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:8px 8px 8px 20px;border-radius:var(--radius-pill);background:var(--surface);box-sizing:border-box"
  >
    <a
      href="#top"
      style="display:flex;align-items:center;gap:10px;text-decoration:none;font-weight:650;font-size:18px;min-height:44px"
    >
      <Image src={helmet} alt="" width={64} height={64} style="display:block;width:32px;height:auto" />
      Helmet
    </a>
    <nav style="display:flex;align-items:center;gap:24px">
      {navLinks.map((l) => (
        <a class="nav-link hide-sm" href={l.href} style="font-size:16px;font-weight:600">
          {l.label}
        </a>
      ))}
      <RollButton href="#top" label="Install" />
    </nav>
  </div>
</header>
