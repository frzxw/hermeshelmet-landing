---
const modes = [
  {
    name: "Skills",
    when: "For a focused ask",
    body: "One short skill card, loaded only when it helps. Design direction, an API shape, a code review.",
    cost: 1,
    costLabel: "Lowest cost",
    tint: "t-sky",
  },
  {
    name: "Flow",
    when: "For bounded work",
    body: "One agent walks clarify, plan, build, review and verify, with a check at every step.",
    cost: 2,
    costLabel: "Low cost",
    tint: "t-clay",
  },
  {
    name: "Agency",
    when: "For a full build",
    body: "A team of role agents on a shared board. It starts only when you say yes, inside a budget you set.",
    cost: 3,
    costLabel: "Bounded by your budget",
    tint: "t-dusk",
  },
];
---

<section id="features" class="sec">
  <div class="wrap">
    <div class="sec-head center">
      <p class="rv eyebrow kicker">How it decides</p>
      <h2 class="rv h2" style="margin-top:16px">
        One conversation.
        <br />
        The right amount of process.
      </h2>
      <p class="rv rv2 lead">
        You never pick a mode or type a command. Helmet reads the request, chooses the lightest setup that fits and
        tells you why in one line.
      </p>
    </div>

    <div class="chat rv" aria-label="Example conversation">
      <div class="bubble bubble-me">Build me a booking app for my barbershop.</div>
      <div class="bubble bubble-ai">
        <span class="who">Helmet</span>
        This is a full build, so I suggest the team: a spec, then the architecture, then engineers in parallel. You
        approve each stage.
        <span class="chat-actions">
          <span class="chip chip-ink">Start the team</span>
          <span class="chip">Keep it small</span>
        </span>
      </div>
    </div>

    <div class="grid3" style="margin-top:20px">
      {modes.map((m, i) => (
        <article class:list={["panel glow rv mode", m.tint, i === 1 && "rv2", i === 2 && "rv3"]}>
          <p class="eyebrow">{m.when}</p>
          <h3 class="mode-name">{m.name}</h3>
          <p class="body-m" style="color:var(--graphite)">
            {m.body}
          </p>
          <div class="cost" aria-label={m.costLabel}>
            <span aria-hidden="true" class="cost-dots">
              {[1, 2, 3].map((n) => (
                <span class:list={["cd", n <= m.cost && "on"]} />
              ))}
            </span>
            <span>{m.costLabel}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
