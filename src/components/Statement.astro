---
import wing from "../assets/hermes-agent-wing.svg";

// Each word lights up from gray to ink as it scrolls into view.
const first = "Hermes remembers everything.".split(" ");
const second = "It just wasn’t ready to".split(" ");
const pillars = [
  { k: "Memory", v: "kept" },
  { k: "Harness", v: "added" },
  { k: "Tokens", v: "saved" },
];
---

<section class="sec stmt2" style="overflow:hidden">
  <div class="wrap" style="text-align:center">
    <figure class="badge-float" aria-label="Built on Hermes Agent by Nous Research">
      <div class="tilt">
        <div class="float">
          <div class="nous-badge">
            <img src={wing.src} width={wing.width} height={wing.height} alt="Hermes Agent logo" />
          </div>
        </div>
      </div>
      <figcaption class="kicker">Built on Hermes Agent</figcaption>
    </figure>

    <h2 class="h2 mega" aria-label="Hermes remembers everything. It just wasn’t ready to work.">
      <span aria-hidden="true">
        {first.map((w) => (
          <span class="lit">{w} </span>
        ))}
        <br />
        {second.map((w) => (
          <span class="lit soft">{w} </span>
        ))}
        <span class="lit" style="position:relative;display:inline-block">
          work.
          <span class="ln-h ln-sun"></span>
        </span>
      </span>
    </h2>

    <ul class="pillars" aria-label="What Helmet changes">
      {pillars.map((p, i) => (
        <li class:list={["rv", i === 1 && "rv2", i === 2 && "rv3"]}>
          <span>{p.k}</span>
          <b>{p.v}</b>
        </li>
      ))}
    </ul>
  </div>
</section>
