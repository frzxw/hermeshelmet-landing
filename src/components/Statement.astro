---
import wing from "../assets/hermes-agent-wing.svg";

const points = [
  {
    title: "Memory, kept.",
    body: "Hermes’ long-term memory stays at the core. Helmet builds on it instead of replacing it.",
    cls: "rv t-sky",
  },
  {
    title: "Harness, added.",
    body: "Planning, routing and verification arrive built in. The batteries a coding agent needs, already in the box.",
    cls: "rv rv2 t-clay",
  },
  {
    title: "Tokens, saved.",
    body: "Agents exchange context through shared files, so work isn’t re-read and caches stay warm.",
    cls: "rv rv3 t-dusk",
  },
];
// Each word lights up from gray to ink as it scrolls into view.
const first = "Hermes remembers everything.".split(" ");
const second = "It just wasn’t ready to".split(" ");
---

<section class="sec" style="overflow:hidden">
  <div class="wrap">
    <div class="stmt">
      <h2 class="h2 h2-xl stmt-h" aria-label="Hermes remembers everything. It just wasn’t ready to work.">
        <span aria-hidden="true">
          {first.map((w) => (
            <span class="lit">{w} </span>
          ))}
          <br />
          {second.map((w) => (
            <span class="lit soft">{w} </span>
          ))}
          <span class="lit" style="position:relative;display:inline-block">
            work.
            <span
              class="ln-h ln-sun"
              style="position:absolute;left:0;right:0;bottom:2px;height:5px;border-radius:var(--radius-pill)"
            ></span>
          </span>
        </span>
      </h2>
      <figure class="stmt-art">
        <div class="tilt">
          <div class="float">
            <div class="nous-badge">
              <img src={wing.src} width={wing.width} height={wing.height} alt="Hermes Agent logo" />
            </div>
          </div>
        </div>
        <figcaption class="eyebrow">Built on Hermes Agent by Nous Research</figcaption>
      </figure>
    </div>
    <p class="rv rv2 lead">Helmet keeps the memory and adds the harness around it.</p>
    <div class="grid3" style="margin-top:64px">
      {points.map((p, i) => (
        <div class:list={[p.cls, "panel glow"]}>
          <span class="num" aria-hidden="true">
            0{i + 1}
          </span>
          <h3 class="title" style="margin-top:40px;font-size:20px;line-height:26px">
            {p.title}
          </h3>
          <p class="body-m">{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
