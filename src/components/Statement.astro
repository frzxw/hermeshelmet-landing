---
const points = [
  {
    title: "Memory, kept.",
    body: "Hermes’ long-term memory stays at the core. Helmet builds on it instead of replacing it.",
    cls: "rv",
  },
  {
    title: "Harness, added.",
    body: "Planning, routing and verification arrive built in. The batteries a coding agent needs, already in the box.",
    cls: "rv rv2",
  },
  {
    title: "Tokens, saved.",
    body: "Agents exchange context through shared files, so work isn’t re-read and caches stay warm.",
    cls: "rv rv3",
  },
];
---

<section class="sec">
  <div class="wrap">
    <h2 class="rv h2" style="max-width:820px">
      Hermes remembers everything.
      <br />
      <span class="soft">It just wasn&rsquo;t ready to</span>{" "}
      <span style="position:relative;display:inline-block">
        work.
        <span
          class="ln-h"
          aria-hidden="true"
          style="position:absolute;left:0;right:0;bottom:-1px;height:4px;border-radius:var(--radius-pill);background:var(--ink)"
        ></span>
      </span>
    </h2>
    <p class="rv rv2 lead">Helmet keeps the memory and adds the harness around it.</p>
    <div class="grid3" style="margin-top:64px">
      {points.map((p) => (
        <div class:list={[p.cls, "panel"]}>
          <h3 class="title" style="font-size:20px;line-height:26px">
            {p.title}
          </h3>
          <p class="body-m">{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
