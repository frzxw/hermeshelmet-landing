---
import { faqs } from "../data/site";
---

<section id="faq" class="sec">
  <div class="wrap" style="display:flex;flex-wrap:wrap;gap:40px 48px;align-items:flex-start">
    <h2
      class="rv stick"
      style="flex:1 1 280px;min-width:0;margin:0;position:sticky;top:120px;font-size:clamp(32px,5vw,44px);line-height:1.13"
    >
      Everything you need to know.
    </h2>
    <div class="rv rv2" style="flex:1.6 1 440px;min-width:0;display:flex;flex-direction:column;gap:12px">
      {faqs.map((f, i) => (
        <details class="faq-item" name="faq" open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <svg
              class="chev"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
