---
/**
 * Live demo of how Helmet plans and shares work.
 * Markup only: src/scripts/console.ts drives it through data-* hooks.
 */
const scenarios = ["Add rate limiting", "Fix a failing test", "Migrate the SDK"];
// Context segments, drawn as stacked layers: data-bar 5 (conversation) is the widest.
const legend = [
  { n: 1, label: "System prompt", size: "10k" },
  { n: 2, label: "Skills", size: "24k" },
  { n: 3, label: "Memory", size: "16k" },
  { n: 4, label: "Tools", size: "16k" },
  { n: 5, label: "Conversation", size: null },
];
---

<section id="console" class="demo in-rise" data-console>
  <div class="frame">
    <div class="demo-bar">
      <div role="group" aria-label="Choose a request" class="seg-group demo-tabs">
        {scenarios.map((label, i) => (
          <button class="seg" type="button" data-scenario={i} aria-pressed={i === 0 ? "true" : "false"}>
            {label}
          </button>
        ))}
      </div>
      <button class="btn btn-2" type="button" data-console-toggle style="height:48px">
        Pause demo
      </button>
    </div>

    <div class="demo-board">
      <!-- Context window -->
      <div class="demo-card demo-ctx glow">
        <div class="demo-head">
          <span>Context</span>
          <span data-ctx-text>60% · 120k / 200k</span>
        </div>
        <div class="ctx-track">
          {[5, 4, 3, 2, 1].map((n) => (
            <div class="cv" data-bar={n} style={`background:var(--ctx-${n})`} />
          ))}
        </div>
        <ul class="ctx-legend">
          {legend.map((row) => (
            <li>
              <span class="ctx-key" style={`background:var(--ctx-${row.n})`} />
              <span>{row.label}</span>
              <span class="ctx-size" data-conv-text={row.size ? undefined : ""}>
                {row.size ?? "54k"}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Agents -->
      <div class="demo-card demo-agents glow">
        <div class="demo-head">
          <span>Agents</span>
          <span>Routing: automatic</span>
        </div>
        <div class="arows">
          <div class="arow">
            <span>Orchestrator</span>
            <span data-o-msg>Reading the request.</span>
            <span class="o-state" data-o-state>
              Reading
            </span>
          </div>
          {[1, 2, 3].map((n) => (
            <div class="arow">
              <span>Worker {n}</span>
              <span data-worker-task={n} />
              <span class="pill" data-worker-pill={n} data-state="idle">
                <span class="pulse" />
                <span data-label>Idle</span>
              </span>
            </div>
          ))}
          <div class="arow arow-sup">
            <span>Supervisor</span>
            <span>Read-only. Checks the work against the plan.</span>
            <span class="pill" data-supervisor-pill data-state="idle">
              <span class="pulse" />
              <span data-label>Idle</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
