---
import { stats } from "../data/site";
---

<section class="sec" aria-label="Helmet in numbers">
  <div class="numbers rv">
    <div class="wrap nums">
      {stats.map((s) => (
        <div class="numcell">
          {"aria" in s ? (
            <div role="img" aria-label={s.aria} class="hugenum">
              <span aria-hidden="true">
                ~<span class="cnt"></span>
                <span class="pct">%</span>
              </span>
            </div>
          ) : (
            <div class="hugenum">{s.value}</div>
          )}
          <p>{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
